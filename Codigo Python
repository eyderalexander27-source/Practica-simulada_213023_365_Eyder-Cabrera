# 5. SERVICIOS (clase abstracta Servicio + 3 servicios concretos)
#    Principios: herencia, polimorfismo y sobrecarga (params opcionales).
# ======================================================================
class Servicio(Entidad):
    """
    Clase abstracta base para todos los servicios de Software FJ.

    Attributes:
        _tarifa_base (float): tarifa unitaria base del servicio.
        _disponible (bool): si el servicio se puede reservar.
    """

    def __init__(self, codigo: str, nombre: str, tarifa_base: float,
                 disponible: bool = True):
        super().__init__(codigo, nombre)
        if tarifa_base is None:
            raise ParametroFaltanteError(
                "La tarifa base del servicio es obligatoria.")
        if not isinstance(tarifa_base, (int, float)) or tarifa_base < 0:
            raise DatoInvalidoError(
                "La tarifa base debe ser un número mayor o igual a cero.")
        self._tarifa_base = float(tarifa_base)
        self._disponible = bool(disponible)

    @property
    def codigo(self) -> str:
        return self._id

    @property
    def tarifa_base(self) -> float:
        return self._tarifa_base

    @property
    def disponible(self) -> bool:
        return self._disponible

    @disponible.setter
    def disponible(self, valor: bool) -> None:
        self._disponible = bool(valor)

    # Métodos abstractos (obligatorios en las clases hijas -> polimorfismo).
    @abstractmethod
    def validar_parametros(self, duracion: float, **kwargs) -> None:
        """Valida los parámetros propios del servicio antes de calcular."""

    @abstractmethod
    def _costo_base(self, duracion: float, **kwargs) -> float:
        """Cálculo interno del costo sin impuestos ni descuentos."""

    def calcular_costo(self, duracion: float, *,
                       impuesto: float = IVA_POR_DEFECTO,
                       descuento: float = 0.0,
                       **kwargs) -> float:
        """
        Calcula el costo final del servicio.

        Variantes de uso (sobrecarga simulada con parámetros opcionales):
          1. calcular_costo(duracion)                     -> IVA por defecto.
          2. calcular_costo(duracion, impuesto=0.05)      -> impuesto propio.
          3. calcular_costo(duracion, descuento=0.10)     -> con descuento.
          4. calcular_costo(duracion, impuesto=0.19, descuento=0.05, ...)

        Returns:
            Costo final redondeado a 2 decimales.
        """
        if not self._disponible:
            raise ServicioNoDisponibleError(
                f"El servicio '{self._nombre}' no está disponible.")
        if duracion is None:
            raise ParametroFaltanteError("La duración es obligatoria.")
        if not isinstance(duracion, (int, float)):
            raise DatoInvalidoError("La duración debe ser numérica.")
        if duracion <= 0:
            raise CalculoInconsistenteError(
                "La duración debe ser mayor a cero para calcular el costo.")
        if not (0 <= impuesto <= 1):
            raise DatoInvalidoError("El impuesto debe estar entre 0 y 1.")
        if not (0 <= descuento <= 1):
            raise DatoInvalidoError("El descuento debe estar entre 0 y 1.")

        # Validación específica del servicio (polimorfismo).
        self.validar_parametros(duracion, **kwargs)

        try:
            base = self._costo_base(duracion, **kwargs)
        except ZeroDivisionError as exc:
            # Encadenamiento de excepciones: se preserva la causa original.
            raise CalculoInconsistenteError(
                "Error interno al calcular el costo base (división por cero)."
            ) from exc

        if base < 0:
            raise CalculoInconsistenteError(
                f"El costo base calculado ({base}) no puede ser negativo.")

        con_descuento = base * (1 - descuento)
        total = con_descuento * (1 + impuesto)
        return round(total, 2)

    def calcular_costo_total(self, duracion: float,
                             extras: Optional[list] = None,
                             **kwargs) -> float:
        """Variante de sobrecarga: recibe una lista de extras y los suma."""
        total = self.calcular_costo(duracion, **kwargs)
        if extras:
            for extra in extras:
                if not isinstance(extra, (int, float)) or extra < 0:
                    raise DatoInvalidoError(
                        f"El extra '{extra}' no es un costo válido.")
                total += extra
        return round(total, 2)

    def describir(self) -> str:
        estado = "disponible" if self._disponible else "NO disponible"
        return (f"Servicio(codigo={self._id}, nombre={self._nombre}, "
                f"tarifa_base={self._tarifa_base}, estado={estado})")


class ReservaSalas(Servicio):
    """Reserva de salas de reuniones. Costo = tarifa por hora * horas."""

    def __init__(self, codigo: str, nombre: str, tarifa_base: float,
                 capacidad: int, disponible: bool = True):
        super().__init__(codigo, nombre, tarifa_base, disponible)
        if capacidad is None:
            raise ParametroFaltanteError(
                "La capacidad de la sala es obligatoria.")
        if not isinstance(capacidad, int) or capacidad <= 0:
            raise DatoInvalidoError(
                "La capacidad debe ser un número entero positivo.")
        self._capacidad = capacidad

    @property
    def capacidad(self) -> int:
        return self._capacidad

    def validar_parametros(self, duracion: float, **kwargs) -> None:
        personas = kwargs.get("personas")
        if personas is not None:
            if not isinstance(personas, int) or personas <= 0:
                raise DatoInvalidoError(
                    "El número de personas debe ser un entero positivo.")
            if personas > self._capacidad:
                raise OperacionNoPermitidaError(
                    f"La sala '{self._nombre}' tiene capacidad para "
                    f"{self._capacidad} personas y se solicitan {personas}.")

    def _costo_base(self, duracion: float, **kwargs) -> float:
        return self._tarifa_base * duracion

    def describir(self) -> str:
        return (f"ReservaSalas(codigo={self._id}, nombre={self._nombre}, "
                f"tarifa_hora={self._tarifa_base}, capacidad={self._capacidad})")


class AlquilerEquipos(Servicio):
    """
    Alquiler de equipos. Costo = tarifa diaria * días + depósito (opcional).
    El depósito es reembolsable, pero se incluye en el cobro inicial.
    """

    def __init__(self, codigo: str, nombre: str, tarifa_base: float,
                 deposito: float = 0.0, disponible: bool = True):
        super().__init__(codigo, nombre, tarifa_base, disponible)
        if not isinstance(deposito, (int, float)) or deposito < 0:
            raise DatoInvalidoError(
                "El depósito debe ser un número mayor o igual a cero.")
        self._deposito = float(deposito)

    @property
    def deposito(self) -> float:
        return self._deposito

    def validar_parametros(self, duracion: float, **kwargs) -> None:
        # duración = días de alquiler (deben ser enteros).
        if not float(duracion).is_integer():
            raise DatoInvalidoError(
                "El alquiler de equipos se factura por días enteros.")

    def _costo_base(self, duracion: float, **kwargs) -> float:
        incluir_deposito = kwargs.get("incluir_deposito", True)
        base = self._tarifa_base * duracion
        if incluir_deposito:
            base += self._deposito
        return base

    def describir(self) -> str:
        return (f"AlquilerEquipos(codigo={self._id}, nombre={self._nombre}, "
                f"tarifa_dia={self._tarifa_base}, deposito={self._deposito})")


class AsesoriaEspecializada(Servicio):
    """
    Asesoría técnica especializada. El costo depende del nivel del asesor:
      - junior    : factor 1.0
      - semisenior: factor 1.35
      - senior    : factor 1.75
    """

    NIVELES = {
        "junior": 1.0,
        "semisenior": 1.35,
        "senior": 1.75,
    }

    def __init__(self, codigo: str, nombre: str, tarifa_base: float,
                 area: str, nivel: str = "junior",
                 disponible: bool = True):
        super().__init__(codigo, nombre, tarifa_base, disponible)
        if not area or not str(area).strip():
            raise ParametroFaltanteError(
                "El área de la asesoría es obligatoria.")
        if nivel not in self.NIVELES:
            raise DatoInvalidoError(
                f"El nivel '{nivel}' no es válido. Opciones: "
                f"{', '.join(self.NIVELES)}.")
        self._area = str(area).strip()
        self._nivel = nivel

    @property
    def area(self) -> str:
        return self._area

    @property
    def nivel(self) -> str:
        return self._nivel

    @property
    def factor_nivel(self) -> float:
        return self.NIVELES[self._nivel]

    def validar_parametros(self, duracion: float, **kwargs) -> None:
        # duración = horas de asesoría. Máximo 8 horas por sesión.
        if duracion > 8:
            raise OperacionNoPermitidaError(
                "Una sesión de asesoría no puede exceder las 8 horas.")

    def _costo_base(self, duracion: float, **kwargs) -> float:
        return self._tarifa_base * duracion * self.factor_nivel

    def describir(self) -> str:
        return (f"AsesoriaEspecializada(codigo={self._id}, nombre={self._nombre}, "
                f"area={self._area}, nivel={self._nivel}, "
                f"tarifa_hora={self._tarifa_base}, factor={self.factor_nivel})")


# ======================================================================
# 6. RESERVA (máquina de estados + procesamiento con try/except/finally)
#    PENDIENTE --confirmar()--> CONFIRMADA --procesar()--> FINALIZADA
#         |                          |
#         +--------cancelar()--------+----> CANCELADA
# ======================================================================
class EstadoReserva(str, Enum):
    """Estados posibles de una reserva."""
    PENDIENTE = "PENDIENTE"
    CONFIRMADA = "CONFIRMADA"
    CANCELADA = "CANCELADA"
    FINALIZADA = "FINALIZADA"


class Reserva:
    """
    Reserva de un servicio para un cliente.

    Args:
        id_reserva: identificador único de la reserva.
        cliente: objeto Cliente asociado.
        servicio: objeto Servicio (cualquiera de las 3 subclases).
        duracion: horas o días según el servicio.
        fecha: fecha de la reserva (str YYYY-MM-DD) o se usa la actual.
        **kwargs: parámetros extra para el cálculo de costo (personas,
            incluir_deposito, impuesto, descuento, extras, etc.).
    """

    _contador = 0

    def __init__(self, id_reserva: str, cliente, servicio, duracion: float,
                 fecha: str | None = None, **kwargs):
        if id_reserva is None or not str(id_reserva).strip():
            raise ParametroFaltanteError("El id de la reserva es obligatorio.")
        if cliente is None:
            raise ParametroFaltanteError("La reserva requiere un cliente.")
        if servicio is None:
            raise ParametroFaltanteError("La reserva requiere un servicio.")

        if not isinstance(cliente, Cliente):
            raise ReservaInvalidaError(
                "El objeto 'cliente' no es una instancia de Cliente.")
        if not isinstance(servicio, Servicio):
            raise ReservaInvalidaError(
                "El objeto 'servicio' no es una instancia de Servicio.")

        self._id = str(id_reserva).strip()
        self._cliente = cliente
        self._servicio = servicio
        self._duracion = duracion
        self._fecha = fecha or datetime.now().strftime("%Y-%m-%d")
        self._parametros_extra = kwargs
        self._estado = EstadoReserva.PENDIENTE
        self._costo_final: float | None = None
        Reserva._contador += 1

    # ---- Propiedades de solo lectura (encapsulación) ----
    @property
    def id(self) -> str:
        return self._id

    @property
    def cliente(self):
        return self._cliente

    @property
    def servicio(self):
        return self._servicio

    @property
    def duracion(self) -> float:
        return self._duracion

    @property
    def estado(self) -> EstadoReserva:
        return self._estado

    @property
    def costo_final(self) -> float | None:
        return self._costo_final

    # ---- Transiciones de estado con validación estricta ----
    def confirmar(self) -> None:
        """Confirma la reserva. Solo se permite desde PENDIENTE."""
        if self._estado == EstadoReserva.CANCELADA:
            raise OperacionNoPermitidaError(
                f"La reserva {self._id} está cancelada y no puede confirmarse.")
        if self._estado == EstadoReserva.CONFIRMADA:
            raise OperacionNoPermitidaError(
                f"La reserva {self._id} ya estaba confirmada.")
        if self._estado == EstadoReserva.FINALIZADA:
            raise OperacionNoPermitidaError(
                f"La reserva {self._id} ya fue finalizada.")
        if not self._servicio.disponible:
            raise ServicioNoDisponibleError(
                f"El servicio '{self._servicio.nombre}' no está disponible "
                f"para confirmar la reserva {self._id}.")
        self._estado = EstadoReserva.CONFIRMADA

    def cancelar(self) -> None:
        """Cancela la reserva. No se puede cancelar una ya finalizada."""
        if self._estado == EstadoReserva.FINALIZADA:
            raise OperacionNoPermitidaError(
                f"La reserva {self._id} ya está finalizada y no se puede "
                f"cancelar.")
        if self._estado == EstadoReserva.CANCELADA:
            raise OperacionNoPermitidaError(
                f"La reserva {self._id} ya estaba cancelada.")
        self._estado = EstadoReserva.CANCELADA

    def procesar(self, logger=None) -> float:
        """
        Calcula el costo final y marca la reserva como FINALIZADA.
        Demuestra: try/except/else/finally y encadenamiento (raise ... from).
        """
        if self._estado != EstadoReserva.CONFIRMADA:
            raise OperacionNoPermitidaError(
                f"La reserva {self._id} debe estar CONFIRMADA para procesarse "
                f"(estado actual: {self._estado.value}).")
        try:
            # NO se muta self._parametros_extra: se extraen los extras y se
            # pasa el resto de parámetros sin alterar el estado original.
            extras = self._parametros_extra.get("extras")
            restantes = {k: v for k, v in self._parametros_extra.items()
                         if k != "extras"}
            if extras is not None:
                costo = self._servicio.calcular_costo_total(
                    self._duracion, extras=extras, **restantes)
            else:
                costo = self._servicio.calcular_costo(
                    self._duracion, **restantes)
        except (ServicioNoDisponibleError, CalculoInconsistenteError) as exc:
            # Encadenamiento: se preserva la causa original.
            if logger:
                logger.error(f"Error al procesar la reserva {self._id}", exc)
            raise ReservaInvalidaError(
                f"No se pudo procesar la reserva {self._id}: {exc}"
            ) from exc
        else:
            # Solo se ejecuta si NO hubo excepción.
            self._costo_final = costo
            self._estado = EstadoReserva.FINALIZADA
            if logger:
                logger.evento(
                    f"Reserva {self._id} procesada. Cliente="
                    f"{self._cliente.nombre}, Servicio={self._servicio.nombre}, "
                    f"Costo=${costo}")
            return costo
        finally:
            # Se ejecuta SIEMPRE, haya error o no.
            if logger:
                logger.evento(
                    f"Fin del flujo de procesamiento de la reserva {self._id} "
                    f"(estado final: {self._estado.value})")

    def describir(self) -> str:
        costo = (f"${self._costo_final}"
                 if self._costo_final is not None else "sin procesar")
        return (f"Reserva(id={self._id}, cliente={self._cliente.nombre}, "
                f"servicio={self._servicio.nombre}, duracion={self._duracion}, "
                f"fecha={self._fecha}, estado={self._estado.value}, "
                f"costo={costo})")

    def __str__(self) -> str:
        return self.describir()


