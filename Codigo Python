# 4. GESTOR DE LOGS (única persistencia: archivo logs/sistema.log)
# ======================================================================
class GestorLogs:
    """
    Gestor centralizado de logs. Escribe eventos, advertencias y errores
    (con traza completa) en un archivo de texto.

    Attributes:
        ruta_log (str): ruta del archivo donde se escriben los registros.
    """

    def __init__(self, nombre_archivo: str = "sistema.log",
                 carpeta: str = "logs"):
        # Garantizar que la carpeta de logs exista.
        if not os.path.isdir(carpeta):
            try:
                os.makedirs(carpeta, exist_ok=True)
            except OSError:
                carpeta = "."  # si no se puede crear, se usa la actual
        self.ruta_log = os.path.join(carpeta, nombre_archivo)
        self._logger = logging.getLogger("SoftwareFJ")
        self._logger.setLevel(logging.DEBUG)
        self._logger.propagate = False
        if not self._logger.handlers:
            manejador = logging.FileHandler(self.ruta_log, encoding="utf-8")
            formato = logging.Formatter(
                "%(asctime)s | %(levelname)-8s | %(message)s",
                datefmt="%Y-%m-%d %H:%M:%S")
            manejador.setFormatter(formato)
            self._logger.addHandler(manejador)

    def evento(self, mensaje: str) -> None:
        """Registra un evento relevante (operación exitosa)."""
        self._logger.info(mensaje)

    def advertencia(self, mensaje: str) -> None:
        """Registra una advertencia que no detiene la ejecución."""
        self._logger.warning(mensaje)

    def error(self, mensaje: str, excepcion: Exception | None = None) -> None:
        """Registra un error. Si se pasa la excepción, anexa la traza completa."""
        if excepcion is not None:
            traza = "".join(traceback.format_exception(
                type(excepcion), excepcion, excepcion.__traceback__))
            self._logger.error("%s | Excepción: %s | Traza:\n%s",
                               mensaje, excepcion, traza.strip())
        else:
            self._logger.error(mensaje)

    def registrar_con_estado(self, operacion: str, funcion) -> None:
        """
        Demuestra el patrón try/except/else/finally:
          - try     : ejecuta la operación recibida.
          - except  : captura cualquier error y lo registra.
          - else    : se ejecuta solo si NO hubo error.
          - finally : escribe el cierre de operación SIEMPRE.
        """
        inicio = datetime.now()
        try:
            resultado = funcion()
        except Exception as exc:
            self.error(f"Fallo la operación '{operacion}'", exc)
            raise
        else:
            self.evento(f"Operación '{operacion}' completada con éxito. "
                        f"Resultado: {resultado}")
        finally:
            duracion = (datetime.now() - inicio).total_seconds()
            self.evento(f"Cierre de operación '{operacion}' "
                        f"(duración {duracion:.4f}s)")

    def separador(self, titulo: str = "") -> None:
        """Escribe una línea separadora en el log para legibilidad."""
        self._logger.info("=" * 60 + (f" {titulo}" if titulo else ""))


