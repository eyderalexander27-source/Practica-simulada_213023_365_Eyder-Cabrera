class SistemaGestion:
    """
    Gestor central del sistema. Toda la información vive en listas en
    memoria (no se usa base de datos). Los errores y eventos se registran
    en el archivo de logs.
    """

    def __init__(self, logger: GestorLogs):
        self.logger = logger
        self.clientes: list[Cliente] = []
        self.servicios: list[Servicio] = []
        self.reservas: list[Reserva] = []

    # ---- Registro de clientes ----
    def registrar_cliente(self, identificacion: str, nombre: str,
                          email: str, telefono: str) -> Cliente | None:
        """Da de alta un cliente. Devuelve el objeto o None si falla."""
        try:
            cliente = Cliente(identificacion, nombre, email, telefono)
        except SistemaGestionError as exc:
            self.logger.error(f"No se pudo registrar el cliente "
                              f"'{nombre}' (id={identificacion})", exc)
            return None
        else:
            for existente in self.clientes:  # evitar duplicados
                if existente.id == cliente.id:
                    self.logger.advertencia(
                        f"El cliente con id {cliente.id} ya existe; "
                        f"se ignora el duplicado.")
                    return existente
            self.clientes.append(cliente)
            self.logger.evento(f"Cliente registrado: {cliente.describir()}")
            return cliente

    # ---- Registro de servicios ----
    def registrar_servicio(self, servicio: Servicio) -> Servicio | None:
        """Da de alta un servicio. Devuelve el objeto o None si falla."""
        try:
            # Encadenamiento: un error de tipo se convierte en error de
            # dominio (raise ... from), preservando la causa original.
            try:
                if not isinstance(servicio, Servicio):
                    raise TypeError("El objeto no es un Servicio válido.")
            except TypeError as exc:
                raise DatoInvalidoError(
                    "Se intentó registrar un servicio inválido.") from exc

            for existente in self.servicios:
                if existente.codigo == servicio.codigo:
                    self.logger.advertencia(
                        f"El servicio con código {servicio.codigo} ya existe.")
                    return existente
            self.servicios.append(servicio)
            self.logger.evento(f"Servicio registrado: {servicio.describir()}")
            return servicio
        except SistemaGestionError as exc:
            self.logger.error("No se pudo registrar el servicio", exc)
            return None

    # ---- Búsquedas ----
    def buscar_cliente(self, identificacion: str):
        for cliente in self.clientes:
            if cliente.id == identificacion:
                return cliente
        raise ClienteNoEncontradoError(
            f"El cliente con id '{identificacion}' no está registrado.")

    def buscar_servicio(self, codigo: str):
        for servicio in self.servicios:
            if servicio.codigo == codigo:
                return servicio
        raise ServicioNoEncontradoError(
            f"El servicio con código '{codigo}' no está registrado.")

    # ---- Creación de reservas ----
    def crear_reserva(self, id_reserva: str, id_cliente: str,
                      codigo_servicio: str, duracion: float,
                      **kwargs) -> Reserva | None:
        """Crea, confirma y procesa una reserva de punta a punta."""
        try:
            cliente = self.buscar_cliente(id_cliente)
            servicio = self.buscar_servicio(codigo_servicio)
            reserva = Reserva(id_reserva, cliente, servicio, duracion,
                              **kwargs)
            reserva.confirmar()
            reserva.procesar(logger=self.logger)
        except SistemaGestionError as exc:
            self.logger.error(
                f"Fallo la creación/procesamiento de la reserva {id_reserva}",
                exc)
            return None
        else:
            cliente.agregar_reserva(reserva)
            self.reservas.append(reserva)
            return reserva

    # ---- Reporte final ----
    def reporte(self) -> str:
        lineas = [
            "=" * 60,
            "REPORTE DEL SISTEMA SOFTWARE FJ (sin base de datos)",
            "=" * 60,
            f"Clientes registrados : {len(self.clientes)}",
            f"Servicios registrados: {len(self.servicios)}",
            f"Reservas procesadas  : {len(self.reservas)}",
            "-" * 60,
            "CLIENTES:",
        ]
        for c in self.clientes:
            lineas.append(f"  * {c.describir()}")
        lineas.append("-" * 60)
        lineas.append("SERVICIOS:")
        for s in self.servicios:
            lineas.append(f"  * {s.describir()}")
        lineas.append("-" * 60)
        lineas.append("RESERVAS:")
        for r in self.reservas:
            lineas.append(f"  * {r.describir()}")
        return "\n".join(lineas)


